# StudySpace Supabase Configuration
# Replace these with your actual Supabase Project URL and Anon Public Key from project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-actual-anon-public-key-here

# Optional: Supabase Storage Bucket for study resources (Default: studyspace_resources)
VITE_SUPABASE_STORAGE_BUCKET=studyspace_resources
